<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Title>Roy Logging MVC</Title>
    <Authors>Jorge Gonzalez</Authors>
    <PackageProjectUrl>https://github.com/Jorge-GitHub/Roy</PackageProjectUrl>
    <Description>ASP.NET Core middleware for Roy Logging: logs every unhandled exception and, if asked, every missing file.</Description>
    <Version>1.0.19</Version>
    <PackageId>Roy.Logging.MVC</PackageId>
    <Copyright>2023-2026</Copyright>
    <PackageIcon>roy-nutget.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Jorge-GitHub/Roy</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>Log;Exception Handling;Logging;Logger;Roy;Exception;MVC;ASP.NET Core</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- Its folder in Avalon.Libraries: the build publishes it there (Directory.Build.props). -->
    <AvalonLibraryFolder>OpenSource</AvalonLibraryFolder>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\..\resources\roy-nutget.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Roy.Logging\Roy.Logging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Avalon.Base.Extensions">
      <HintPath>$(AvalonLibraries)Base/Avalon.Base.Extensions.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
