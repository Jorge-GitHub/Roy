<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Its folder in Avalon.Libraries: the build publishes it there (Directory.Build.props). -->
    <AvalonLibraryFolder>OpenSource</AvalonLibraryFolder>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Roy.Logging\Roy.Logging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Avalon.Base.Extensions">
      <HintPath>$(AvalonLibraries)Base/Avalon.Base.Extensions.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
